    {
      "id": "q7HNR4M4Ogj8s9_7rP57h",
      "type": "text",
      "x": 933.1428571428577,
      "y": 2493.8809523809537,
      "width": 1386.013427734375,
      "height": 203.00000000000202,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffd8a8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 395080476,
      "version": 639,
      "versionNonce": 1876450084,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786475095139,
      "link": null,
      "locked": false,
      "text": "As soon as user orders something a socket is created with server then appoval service will reoslve the address first \nand then will notify the third party gated-system apps also if they return success it will update the app with \nsame socket and after succeful resposnse or even after error.\n\nThe socket will have 5 mins of expiration if user isn't responed to prompt socket connection will br destroyed.\n\nThe address service will havee one cron job which will run daily morning and will add unique address daily into our database",
      "fontSize": 23.20000000000023,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As soon as user orders something a socket is created with server then appoval service will reoslve the address first \nand then will notify the third party gated-system apps also if they return success it will update the app with \nsame socket and after succeful resposnse or even after error.\n\nThe socket will have 5 mins of expiration if user isn't responed to prompt socket connection will br destroyed.\n\nThe address service will havee one cron job which will run daily morning and will add unique address daily into our database",
      "autoResize": true,
      "lineHeight": 1.25
    },
