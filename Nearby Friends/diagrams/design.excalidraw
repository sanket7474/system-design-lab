      "updated": 1785682758482,
      "link": null,
      "locked": false,
      "text": "# DAU                                : 10M\n# Concurrent Active Users        : 1M\n# Location Update Interval       : 30 sec\n# Average Friends Per User       : 200\n# Nearby Search Radius            : 1km, 5km, 10km\n\n\n# Write Traffic Calculation\n   1,000,000 concurrent users / 30 sec = 33,333 updates/sec\n   Peak Traffic 2x                           = 70,000 writes/sec \n\n\n# Read Traffic Calculation\n   1,000,000 concurrent users / 120 sec = 8,333 reads/sec\n   Peak Traffic 2x                            = 20,000 reads/sec ",
      "fontSize": 36.03937026470064,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# DAU                                : 10M\n# Concurrent Active Users        : 1M\n# Location Update Interval       : 30 sec\n# Average Friends Per User       : 200\n# Nearby Search Radius            : 1km, 5km, 10km\n\n\n# Write Traffic Calculation\n   1,000,000 concurrent users / 30 sec = 33,333 updates/sec\n   Peak Traffic 2x                           = 70,000 writes/sec \n\n\n# Read Traffic Calculation\n   1,000,000 concurrent users / 120 sec = 8,333 reads/sec\n   Peak Traffic 2x                            = 20,000 reads/sec ",
      "autoResize": true,
      "lineHeight": 1.25
    },
