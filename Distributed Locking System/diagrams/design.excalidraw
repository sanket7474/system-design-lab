    },
    {
      "id": "OCVna0i_upONKK86DECoa",
      "type": "text",
      "x": 20.705501302083235,
      "y": 2147.047619047619,
      "width": 1928.346923828125,
      "height": 475.00000000000006,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 1538102801,
      "version": 479,
      "versionNonce": 1495775647,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788890938950,
      "link": null,
      "locked": false,
      "text": "- You got in, slide the latch -> the outside flips to OCCUPIED\n- Everyone else sees OCCUPIED and waits.\n- You come out, the latch releases -> the sign flips to VACANT.\n- Now one of the waiting people goes in\n- Loop comtinues only single person at time allowed to occupy the toilet.\n\n\n\nNow if the person inside faints. Nobody can getin, they wait forever. That could be a case of deadlock.\nSolution is using a TTL.  ",
      "fontSize": 38.00000000000001,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- You got in, slide the latch -> the outside flips to OCCUPIED\n- Everyone else sees OCCUPIED and waits.\n- You come out, the latch releases -> the sign flips to VACANT.\n- Now one of the waiting people goes in\n- Loop comtinues only single person at time allowed to occupy the toilet.\n\n\n\nNow if the person inside faints. Nobody can getin, they wait forever. That could be a case of deadlock.\nSolution is using a TTL.  ",
      "autoResize": true,
      "lineHeight": 1.25
    },
