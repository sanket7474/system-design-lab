    {
      "id": "tINJTAtUZrHT8SYZ38ibW",
      "type": "text",
      "x": 496.95550130208323,
      "y": 6206.214285714284,
      "width": 577.5998196072018,
      "height": 94.99999999999952,
      "angle": 0,
      "strokeColor": "#1e1e1e",
