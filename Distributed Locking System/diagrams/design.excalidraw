      "type": "text",
      "x": 606.9555013020828,
      "y": 10527.88095238095,
      "width": 921.1397094726562,
      "height": 1154.9999999999839,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
