    {
      "id": "zZxSMODnpZXZYSDDC0HAZ",
      "type": "text",
      "x": 573.6221679687497,
      "y": 8311.21428571428,
      "width": 2406.990966796875,
      "height": 996.9696969696998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 901539441,
      "version": 946,
      "versionNonce": 1232409265,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788896218367,
      "link": null,
      "locked": false,
      "text": "t = 0    Process A    requests a lock to create a report\nt = 1     Process A    lock aquired process starts creating report\nt = 5     Process A    Hungs/ freezes\n \nt = 10                    TTL expired lock is now free\nt = 12    Process B     requests a lock to create a report\nt = 13    Process B     lock aquired process starts creating report\nt = 20   Process B     process completed\n\nt = 22   Process A     wakes up and auires a lock\nt = 25   Process A     process complete   \n\nHere as process A was stcuk process BB compoleted that task now a stale proces woke up annd completed the same task \nwhich it is not supposed to do.\n\nSoln is Fencing:\n\nIt is a number that only increases and is assigned to each process. The process gets rejected if it caaries a lower \nnumber that the highest.\n ",
      "fontSize": 39.878787878787996,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "t = 0    Process A    requests a lock to create a report\nt = 1     Process A    lock aquired process starts creating report\nt = 5     Process A    Hungs/ freezes\n \nt = 10                    TTL expired lock is now free\nt = 12    Process B     requests a lock to create a report\nt = 13    Process B     lock aquired process starts creating report\nt = 20   Process B     process completed\n\nt = 22   Process A     wakes up and auires a lock\nt = 25   Process A     process complete   \n\nHere as process A was stcuk process BB compoleted that task now a stale proces woke up annd completed the same task \nwhich it is not supposed to do.\n\nSoln is Fencing:\n\nIt is a number that only increases and is assigned to each process. The process gets rejected if it caaries a lower \nnumber that the highest.\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
