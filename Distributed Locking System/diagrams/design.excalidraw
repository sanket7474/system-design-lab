      "text": "Aiplane Toilet Scenario",
      "fontSize": 52.000000000000014,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aiplane Toilet Scenario",
      "autoResize": true,
