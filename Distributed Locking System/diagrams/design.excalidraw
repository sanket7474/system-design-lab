    {
      "id": "OopLACZyBwCTGIFkgmhrS",
      "type": "text",
      "x": 1857.62216796875,
      "y": 1184.2142857142858,
      "width": 1148.531494140625,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1889816689,
      "version": 617,
      "versionNonce": 995279729,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788880713226,
      "link": null,
      "locked": false,
      "text": "t1      Node 1    Read Stock = 1\nt2     Node 2    Read Stock = 1     Since Node 1 hasen't written yet stock is still 1\nt3     Node 1     if stock > 0 ----->  Sell \nt4     Node 2    if stock > 0 ----->  Sell\nt5     Node 1     Write Stock = 0\nt6     NNode 2   Write Stock = 0 \n\nScince both system concurrenlty read the stock at same time they got stock = 1\n\nWhile writing if to DB the stock > 0 check passed, hence both requests sold \nthe 2 stocks even though avaible quiantity was 1\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "t1      Node 1    Read Stock = 1\nt2     Node 2    Read Stock = 1     Since Node 1 hasen't written yet stock is still 1\nt3     Node 1     if stock > 0 ----->  Sell \nt4     Node 2    if stock > 0 ----->  Sell\nt5     Node 1     Write Stock = 0\nt6     NNode 2   Write Stock = 0 \n\nScince both system concurrenlty read the stock at same time they got stock = 1\n\nWhile writing if to DB the stock > 0 check passed, hence both requests sold \nthe 2 stocks even though avaible quiantity was 1\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
