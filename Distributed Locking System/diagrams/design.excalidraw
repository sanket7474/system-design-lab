      "seed": 363082655,
      "version": 34,
      "versionNonce": 1482749969,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788927294208,
      "link": null,
      "locked": false,
      "text": "POST api/v1/locks/acquire\n\nreq {\n  lockKey: \"us-east:payments:order:123\",\n  ownerId: \"payment-worker-17:attempt-01\",\n  ttlMs: 30000,\n  mode: \"EXCLUSIVE\",\n  waitMode: \"NO_WAIT\",\n  acquireTimeoutMs: 0,\n  fair: false,\n  metadata: {\n    traceId: \"tr_8b2e9d\",\n    purpose: \"mark-order-paid\"\n  }\n}\n\nres 200 {\n  status: \"GRANTED\",\n}\n\n",
      "fontSize": 43.99999999999939,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST api/v1/locks/acquire\n\nreq {\n  lockKey: \"us-east:payments:order:123\",\n  ownerId: \"payment-worker-17:attempt-01\",\n  ttlMs: 30000,\n  mode: \"EXCLUSIVE\",\n  waitMode: \"NO_WAIT\",\n  acquireTimeoutMs: 0,\n  fair: false,\n  metadata: {\n    traceId: \"tr_8b2e9d\",\n    purpose: \"mark-order-paid\"\n  }\n}\n\nres 200 {\n  status: \"GRANTED\",\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
