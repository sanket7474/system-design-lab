      "isDeleted": false,
      "boundElements": [],
      "updated": 1788880109216,
      "link": null,
      "locked": false,
      "text": " Concurrency Management\n\n- Atomic lock acquisition.\n- Atomic lock release.\n- Atomic lock renewal.\n- Prevent lock stealing.\n- Prevent split-brain scenarios.\n",
      "fontSize": 26.845869459411556,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Concurrency Management\n\n- Atomic lock acquisition.\n- Atomic lock release.\n- Atomic lock renewal.\n- Prevent lock stealing.\n- Prevent split-brain scenarios.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
