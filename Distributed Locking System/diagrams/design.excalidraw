      "updated": 1788927347269,
      "link": null,
      "locked": false,
      "text": "POST api/v1/locks/renew\nrenew an existing lease\n\nreq {\n  lockKey: \"us-east:payments:order:123\",\n  ownerId: \"payment-worker-17:attempt-01\",\n  fenceToken: 884201,\n  ttlMs: 30000\n}\nres 200 {\n  renewed: true\n}",
      "fontSize": 43.99999999999939,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST api/v1/locks/renew\nrenew an existing lease\n\nreq {\n  lockKey: \"us-east:payments:order:123\",\n  ownerId: \"payment-worker-17:attempt-01\",\n  fenceToken: 884201,\n  ttlMs: 30000\n}\nres 200 {\n  renewed: true\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
