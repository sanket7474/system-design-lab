      "link": null,
      "locked": false,
      "text": "POST api/v1/locks/{lockKey}/release\nrelease a lock\n\nreq {\n  lockKey: \"us-east:payments:order:123\",\n  ownerId: \"payment-worker-17:attempt-01\",\n  sessionId: \"ses_01J7Y6G9QK8M9R2P4V6T1A0B3C\",\n  fenceToken: 884201\n}\nres 200 {\n  released: true,\n}",
      "fontSize": 43.99999999999939,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST api/v1/locks/{lockKey}/release\nrelease a lock\n\nreq {\n  lockKey: \"us-east:payments:order:123\",\n  ownerId: \"payment-worker-17:attempt-01\",\n  sessionId: \"ses_01J7Y6G9QK8M9R2P4V6T1A0B3C\",\n  fenceToken: 884201\n}\nres 200 {\n  released: true,\n}",
      "autoResize": true,
      "lineHeight": 1.25
