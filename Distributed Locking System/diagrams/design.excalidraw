      "link": null,
      "locked": false,
      "text": "POST api/v1/admin/locks/force-unlock\nforce unlock a stuck lock\nreq {\n  lockKey: \"us-east:payments:order:123\",\n  reason: \"holder session stuck during incident INC-4421\",\n  ticketId: \"INC-4421\",\n  approverId: \"user:payments-oncall-lead\",\n  notifyWaiters: true\n}\n\nres 200 {\n  unlocked: true\n}\n",
      "fontSize": 43.99999999999939,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST api/v1/admin/locks/force-unlock\nforce unlock a stuck lock\nreq {\n  lockKey: \"us-east:payments:order:123\",\n  reason: \"holder session stuck during incident INC-4421\",\n  ticketId: \"INC-4421\",\n  approverId: \"user:payments-oncall-lead\",\n  notifyWaiters: true\n}\n\nres 200 {\n  unlocked: true\n}\n",
      "autoResize": true,
