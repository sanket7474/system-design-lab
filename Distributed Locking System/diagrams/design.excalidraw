      "version": 64,
      "versionNonce": 653336914,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788710837513,
      "link": null,
      "locked": false,
      "text": "Lock Types\n\n- Exclusive Lock.\n- Shared Lock.\n- Reentrant Lock.\n- Read Lock.\n- Write Lock.\n- Fair Lock.\n- Lease-Based Lock.",
      "fontSize": 24.067524784306855,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lock Types\n\n- Exclusive Lock.\n- Shared Lock.\n- Reentrant Lock.\n- Read Lock.\n- Write Lock.\n- Fair Lock.\n- Lease-Based Lock.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iGQIwcVMZe56bzdM82fgh",
      "type": "text",
      "x": -86.5,
      "y": 398.7667194932469,
      "width": 394.5263671875,
      "height": 289.57304455391215,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 726269390,
      "version": 58,
      "versionNonce": 358271097,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788795333024,
      "link": null,
      "locked": false,
      "text": " \nLock Lifecycle\n\n- Automatic lock expiration.\n- Heartbeat-based lock renewal.\n- Dead lock recovery.\n- Lock ownership validation.\n- Lock timeout handling.\n",
      "fontSize": 25.739826182569967,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " \nLock Lifecycle\n\n- Automatic lock expiration.\n- Heartbeat-based lock renewal.\n- Dead lock recovery.\n- Lock ownership validation.\n- Lock timeout handling.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7nO7V9T0f6mQmQvCRue0E",
      "type": "text",
      "x": 903.5,
      "y": 432,
      "width": 401.02333779000173,
      "height": 268.4586945941156,
      "angle": 0,
