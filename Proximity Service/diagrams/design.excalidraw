      "index": "b16",
      "roundness": null,
      "seed": 610487509,
      "version": 95,
      "versionNonce": 1937833557,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784483357391,
      "link": null,
      "locked": false,
      "text": "Assumptions\n\n- 100M POIs\n- 100M DAU\n- Average 5 searches/day\n",
      "fontSize": 29.238440120844658,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumptions\n\n- 100M POIs\n- 100M DAU\n- Average 5 searches/day\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cRzZgfiDDcUb15vjApimi",
      "type": "text",
      "x": 152.64726053873602,
      "y": 2759.666666666667,
      "width": 682.0101725260427,
      "height": 216.66666666666717,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b17",
      "roundness": null,
      "seed": 18248725,
      "version": 102,
      "versionNonce": 555763349,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784483501409,
      "link": null,
      "locked": false,
      "text": "\nRead QPS\n\n100M × 5 / 86400 ≈ 5,800 QPS average\n\nAssuming 20x peak traffic: ≈ 120,000 QPS peak",
      "fontSize": 28.888888888888943,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nRead QPS\n\n100M × 5 / 86400 ≈ 5,800 QPS average\n\nAssuming 20x peak traffic: ≈ 120,000 QPS peak",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cmiyOvc1ZrYVcWW3_gK8F",
      "type": "text",
      "x": 1044.2385691324864,
      "y": 2731.3333333333335,
      "width": 620.2459280508534,
      "height": 327.9943356214294,
      "angle": 0,
