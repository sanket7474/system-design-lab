      "isDeleted": false,
      "boundElements": [],
      "updated": 1784483497376,
      "link": null,
      "locked": false,
      "text": "Storage\n\nAssume:\n100M POIs\n500 bytes per POI\n\n100M × 500 ≈ 50 GB\n\nEven with indexing overhead: ≈ 100-150 GB",
