      "updated": 1784562097231,
      "link": null,
      "locked": false,
      "text": "CRUD::\nGET      /api/v1/business/{:placeId}   - Get Business Details\nPOST     /api/v1/business                  - Add Business\nPUT       /api/v1/business/{:placeId}    - Update Business Details\nDELETE  /api/v1/business/{:placeId}   - Delete Business \n\n        \n\n\n\n\n\n\n\n",
      "fontSize": 37.99999999999995,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CRUD::\nGET      /api/v1/business/{:placeId}   - Get Business Details\nPOST     /api/v1/business                  - Add Business\nPUT       /api/v1/business/{:placeId}    - Update Business Details\nDELETE  /api/v1/business/{:placeId}   - Delete Business \n\n        \n\n\n\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
