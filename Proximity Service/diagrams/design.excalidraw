    {
      "id": "TqpQ_uG5TNNaXijlk8f_5",
      "type": "text",
      "x": 129.99999999999955,
      "y": 846.3333333333334,
      "width": 1553.652925618493,
      "height": 68.33333333333348,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
