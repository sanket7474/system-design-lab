      "link": null,
      "locked": false,
      "text": " Availability\n\n- 99.99% availability\n- No single point of failure\n- Multi-region deployment",
      "fontSize": 29.86666666666661,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Availability\n\n- 99.99% availability\n- No single point of failure\n- Multi-region deployment",
