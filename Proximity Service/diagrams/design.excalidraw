    },
    {
      "id": "4gXe72rqtl77hA3n7DQGP",
      "type": "text",
      "x": 150.90523579915322,
      "y": 2449.666666666667,
      "width": 634.3115112304682,
      "height": 209.9999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
