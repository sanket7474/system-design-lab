      "index": "b15",
      "roundness": null,
      "seed": 1040599995,
      "version": 41,
      "versionNonce": 153108283,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784483232708,
      "link": null,
      "locked": false,
      "text": "Accuracy\nResults must:\n\n- Stay within requested radius\n- Return exact distance calculations\n- Avoid missing nearby POIs at cell boundaries",
      "fontSize": 27.999999999999975,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Accuracy\nResults must:\n\n- Stay within requested radius\n- Return exact distance calculations\n- Avoid missing nearby POIs at cell boundaries",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oA6KqDhZDOv5J0eOilhW4",
      "type": "text",
      "x": 1070.9052357991532,
      "y": 2464.6666666666665,
      "width": 363.95977783203153,
      "height": 219.2883009063349,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
