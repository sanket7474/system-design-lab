      "boundElements": [],
      "updated": 1787081558171,
      "link": null,
      "locked": false,
      "text": "Trace:    The complete journey of a request\nthrough your system\nSpan:     A single unit of work within a trace\n(e.g., a database query or HTTP call)\nTrace ID:    A unique identifier shared by all\nspans in a trace",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a3LfSQGlonJJyocLSFYJD",
      "originalText": "Trace:    The complete journey of a request through your system\nSpan:     A single unit of work within a trace        (e.g., a database query or HTTP call)\nTrace ID:    A unique identifier shared by all spans in a trace",
      "autoResize": true,
      "lineHeight": 1.25
    },
