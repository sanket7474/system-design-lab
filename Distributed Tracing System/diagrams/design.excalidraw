    {
      "id": "KBKgeiyAz6gcu8lN_zgBv",
      "type": "text",
      "x": 1722.642714243087,
      "y": -131.47619047618974,
      "width": 496.07965087890625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
