      "seed": 526982521,
      "version": 45,
      "versionNonce": 466100025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787078764420,
      "link": null,
      "locked": false,
      "text": "# Search & Query\n\n- Search traces by Trace ID.\n- Search traces by Service Name.\n- Search traces by Time Range.\n- Search traces by Error Status.\n- Search traces by Latency.\n- Search traces using Tags and Attributes.\n\n# Visualization\n\n- Trace Timeline View.\n- Waterfall View.\n- Service Dependency Graph.\n- Critical Path Analysis.\n- Error Highlighting.\n- Trace Comparison.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Search & Query\n\n- Search traces by Trace ID.\n- Search traces by Service Name.\n- Search traces by Time Range.\n- Search traces by Error Status.\n- Search traces by Latency.\n- Search traces using Tags and Attributes.\n\n# Visualization\n\n- Trace Timeline View.\n- Waterfall View.\n- Service Dependency Graph.\n- Critical Path Analysis.\n- Error Highlighting.\n- Trace Comparison.",
      "autoResize": true,
      "lineHeight": 1.25
    },
